# Connection string PostgreSQL de la base Neon.
# À récupérer dans la console Neon, onglet "Connection string".
# sslmode=verify-full vérifie le certificat du serveur. C'est le comportement
# que pg applique aujourd'hui à sslmode=require, mais il l'affaiblira en v9.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=verify-full&channel_binding=require"

# Secret utilisé par Better Auth pour signer les cookies de session.
# En générer un au hasard, jamais réutiliser celui d'un autre environnement :
#   openssl rand -base64 32
BETTER_AUTH_SECRET="remplace-moi-par-un-secret-genere-au-hasard"

# URL publique du backend, utilisée par Better Auth pour ses redirections.
# Optionnelle en local : par défaut http://localhost:$PORT.
BETTER_AUTH_URL="http://localhost:3000"

# Origines du frontend autorisées, séparées par des virgules.
# Lue à la fois par la config CORS et par les `trustedOrigins` de Better Auth :
# une origine absente d'ici fait échouer l'authentification en cross-origin.
# Optionnelle en local, où les ports de développement de Vite sont le défaut.
FRONTEND_ORIGINS="http://localhost:5173,http://localhost:5174"
